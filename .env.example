# Copy to .env.local and fill in. Never commit real keys.

# Public URL of this app (PayPal redirects back here after approval)
APP_BASE_URL=http://localhost:3000

# Postgres connection string. Leave empty to use embedded PGlite in ./.data/pglite
DATABASE_URL=
SEED_ON_START=true

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same app's Webhooks section (needed to verify webhook signatures)
PAYPAL_WEBHOOK_ID=

# Sandbox personal accounts that receive Payouts (developer.paypal.com > Sandbox > Accounts)
SANDBOX_CONTRACTOR_EMAIL=
SANDBOX_SUPPLIER_EMAIL=
SANDBOX_INSPECTOR_EMAIL=

# Shared secret for the reconcile cron endpoint (POST /api/cron/reconcile)
CRON_SECRET=

# Google Gemini (aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Elastic (Serverless project endpoint + API key)
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# Channel3 (trychannel3.com/developers, promo code PAYPAL-HACKATHON-2026)
CHANNEL3_API_KEY=
